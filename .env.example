# Copy this file to .env.local and replace the placeholder with your Maritime API key.
# .env.local is gitignored. Never commit a real key.
#
# Create a key in the Maritime dashboard (Settings > API keys) or with `maritime keys create`.
# Use a full-access key: tests/live_test.py creates, uses and deletes agents.
MARITIME_API_KEY=mk_your_api_key
